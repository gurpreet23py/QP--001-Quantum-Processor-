        "import pennylane as qml\n",
        "import numpy as np\n",
        "\n",
        "# ==========================================\n",
        "# QP-001 AUTOMATIC ERROR DETECTION ENGINE\n",
        "# ==========================================\n",
        "\n",
        "shots = 5000\n",
        "error_rate = 0.05\n",
        "\n",
        "# 3 data qubits + 2 ancilla qubits\n",
        "dev = qml.device(\n",
        "    \"default.mixed\",\n",
        "    wires=5,\n",
        "    shots=shots\n",
        ")\n",
        "\n",
        "@qml.qnode(dev)\n",
        "def automatic_error_correction():\n",
        "\n",
        "    # STEP 1: Prepare logical |1>\n",
        "    qml.PauliX(wires=0)\n",
        "\n",
        "    # STEP 2: Encode |1> as |111>\n",
        "    qml.CNOT(wires=[0, 1])\n",
        "    qml.CNOT(wires=[0, 2])\n",
        "\n",
        "    # STEP 3: Introduce random bit-flip errors\n",
        "    for i in range(3):\n",
        "        qml.BitFlip(error_rate, wires=i)\n",
        "\n",
        "    # STEP 4: Measure error syndromes\n",
        "    # Ancilla 3 checks parity of qubits 0 and 1\n",
        "    qml.CNOT(wires=[0, 3])\n",
        "    qml.CNOT(wires=[1, 3])\n",
        "\n",
        "    # Ancilla 4 checks parity of qubits 1 and 2\n",
        "    qml.CNOT(wires=[1, 4])\n",
        "    qml.CNOT(wires=[2, 4])\n",
        "\n",
        "    s01 = qml.measure(wires=3)\n",
        "    s12 = qml.measure(wires=4)\n",
        "\n",
        "    # STEP 5: Automatically correct identified errors\n",
        "\n",
        "    # Error on qubit 0: syndrome 10\n",
        "    qml.cond(s01 & ~s12, qml.PauliX)(wires=0)\n",
        "\n",
        "    # Error on qubit 1: syndrome 11\n",
        "    qml.cond(s01 & s12, qml.PauliX)(wires=1)\n",
        "\n",
        "    # Error on qubit 2: syndrome 01\n",
        "    qml.cond(~s01 & s12, qml.PauliX)(wires=2)\n",
        "\n",
        "    # STEP 6: Measure corrected data qubits\n",
        "    return qml.sample(wires=[0, 1, 2])\n",
        "\n",
        "\n",
        "# Execute processor\n",
        "results = automatic_error_correction()\n",
        "\n",
        "# STEP 7: Analyse corrected results\n",
        "correct_errors = np.sum(\n",
        "    np.any(results != 1, axis=1)\n",
        ")\n",
        "\n",
        "correct_percentage = (\n",
        "    correct_errors / shots\n",
        ") * 100\n",
        "\n",
        "print(\"QP-001 AUTOMATIC ERROR CORRECTION\")\n",
        "print(\"----------------------------------\")\n",
        "print(\"Total measurements:\", shots)\n",
        "print(\"Bit-flip probability:\", error_rate)\n",
        "print(\"Logical errors after correction:\", correct_errors)\n",
        "print(\"Corrected logical error rate:\",\n",
