      "source": [
        "import pennylane as qml\n",
        "\n",
        "# Create a device with 3 qubits (wires)\n",
        "dev_multi = qml.device('default.qubit', wires=3)\n",
        "\n",
        "@qml.qnode(dev_multi)\n",
        "def multi_qubit_circuit():\n",
        "    # 1. Prepare a 3-qubit GHZ state (|000> + |111>) / sqrt(2)\n",
        "    qml.Hadamard(wires=0)\n",
        "    qml.CNOT(wires=[0, 1])\n",
        "    qml.CNOT(wires=[1, 2])\n",
        "\n",
        "    # 2. Return the probabilities for all computational basis states\n",
        "    return qml.probs(wires=[0, 1, 2])\n",
        "\n",
        "# Run the circuit and display the probabilities\n",
        "probabilities = multi_qubit_circuit()\n",
        "for state, prob in enumerate(probabilities):\n",
        "    print(f\"State |{state:03b}> probability: {prob:.4f}\")"
