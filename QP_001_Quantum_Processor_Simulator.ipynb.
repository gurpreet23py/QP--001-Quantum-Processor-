   "source": [
    "## 5) Quantum error correction: repetition code\n",
    "\n",
    "We will encode a logical state into three physical qubits and use a majority vote decoder to detect bit-flip errors.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def repetition_code_experiment(error_rate=0.05, shots=5000):\n",
    "    dev = qml.device(\"default.mixed\", wires=3)\n",
    "    \n",
    "    @qml.qnode(dev, shots=shots)\n",
    "    def noisy_repetition_code():\n",
    "        qml.PauliX(wires=0)\n",
    "        qml.CNOT(wires=[0, 1])\n",
    "        qml.CNOT(wires=[0, 2])\n",
    "        for i in range(3):\n",
    "            qml.BitFlip(error_rate, wires=i)\n",
    "        return qml.sample(wires=[0, 1, 2])\n",
    "\n",
    "    results = noisy_repetition_code()\n",
    "\n",
    "    raw_errors = np.sum(results[:, 0] != 1)\n",
    "    corrected_bits = (np.sum(results, axis=1) >= 2).astype(int)\n",
    "    corrected_errors = np.sum(corrected_bits != 1)\n",
    "\n",
    "    return {\n",
    "        \"raw_errors\": int(raw_errors),\n",
    "        \"corrected_errors\": int(corrected_errors),\n",
    "        \"raw_error_percentage\": (raw_errors / shots) * 100,\n",
    "        \"corrected_error_percentage\": (corrected_errors / shots) * 100,\n",
    "        \"results\": results,\n",
    "    }\n",
    "\n",
    "experiment = repetition_code_experiment()\n",
    "print(\"Raw errors:\", experiment[\"raw_errors\"])\n",
    "print(\"Corrected errors:\", experiment[\"corrected_errors\"])\n",
    "print(\"Raw error percentage:\", round(experiment[\"raw_error_percentage\"], 2), \"%\")\n",
    "print(\"Corrected error percentage:\", round(experiment[\"corrected_error_percentage\"], 2), \"%\")\n"
   ]
  },
  {
