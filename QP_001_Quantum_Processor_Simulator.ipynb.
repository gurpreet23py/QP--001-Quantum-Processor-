   "metadata": {},
   "source": [
    "## 6) Building a reusable quantum processor abstraction\n",
    "\n",
    "This structure makes the notebook more project-like. It separates the simulation setup from the experiments.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class QuantumProcessorSimulator:\n",
    "    def __init__(self, qubits=4, noise_level=0.0):\n",
    "        self.qubits = qubits\n",
    "        self.noise_level = noise_level\n",
    "        self.device = qml.device(\"default.mixed\" if noise_level > 0 else \"default.qubit\", wires=qubits)\n",
    "\n",
    "    def bell_state(self, shots=1024):\n",
    "        @qml.qnode(self.device, shots=shots)\n",
    "        def circuit():\n",
    "            qml.Hadamard(0)\n",
    "            qml.CNOT([0, 1])\n",
    "            return qml.sample(wires=[0, 1])\n",
    "        return circuit()\n",
    "\n",
    "    def ghz_state(self, shots=1024):\n",
    "        @qml.qnode(self.device, shots=shots)\n",
    "        def circuit():\n",
    "            qml.Hadamard(0)\n",
    "            for i in range(self.qubits - 1):\n",
    "                qml.CNOT([i, i + 1])\n",
    "            return qml.sample(wires=range(self.qubits))\n",
    "        return circuit()\n",
    "\n",
    "    def summary(self):\n",
    "        print(f\"Quantum processor initialized with {self.qubits} qubits\")\n",
    "        print(f\"Noise model active: {self.noise_level > 0}\")\n",
    "\n",
    "\n",
    "sim = QuantumProcessorSimulator(qubits=4, noise_level=0.0)\n",
    "sim.summary()\n",
    "print(\"Bell samples:\", sim.bell_state(shots=100)[:10])\n",
    "print(\"GHZ samples:\", sim.ghz_state(shots=20)[:10])\n"
   ]
